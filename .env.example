# Copy to .env and fill in. Never commit .env — .gitignore excludes .env*.

# Neon Postgres. Use the POOLED connection string (the host with "-pooler" in it).
# Keep the app and the database in the same region: latency here is round-trip bound.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Hugging Face Space running inference/. Must be "owner/space-name".
# The token needs READ access only — write access is for pushing the Space, not running it.
HF_SPACE=owner/space-name
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Local dev escape hatch: run `cd inference && ./.venv/bin/python app.py` and point here
# instead of deploying. HF_SPACE takes precedence when both are set, so leave this unset
# in production.
# INFERENCE_URL=http://127.0.0.1:7860

# Gate for /admin, which mints API keys and edits the thresholds that decide compliance
# verdicts. Access is REFUSED when this is unset — it never defaults open.
ADMIN_PASSWORD=change-me

# Shared secret for `dooh push-packs`, which publishes a tag into the RUNNING model without
# restarting it. Set the SAME value as RELOAD_SECRET in the Space's environment (Settings →
# Variables and secrets). Publishing is refused when either side is unset. Do not reuse
# HF_TOKEN: that one is read-scoped and already deployed to the web tier and to CI.
RELOAD_SECRET=change-me-too

# Optional. Defaults shown.
# LOG_LEVEL=INFO
# PLAYGROUND_RATE_LIMIT_PER_MIN=20
