# Copy to .env and fill in. Never commit .env — .gitignore excludes .env*.
#
# .env.local is read too, and wins over .env when both set the same key. Real environment
# variables outrank both. Nothing here raises on a missing value: a missing DATABASE_URL
# degrades /api/v1/health into a report of the problem rather than a process that will not
# boot. Monitoring you cannot reach is not monitoring.

# Neon Postgres. Use the POOLED connection string (the host with "-pooler" in it).
# Keep the app and the database in the same region: latency here is round-trip bound.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Gate for /admin, which mints API keys and edits the tag catalog — the catalog IS the
# prompt, so this is the password that decides what compliance means. Access is REFUSED
# when this is unset; it never defaults open.
ADMIN_PASSWORD=change-me

# Optional. Defaults shown.
# LOG_LEVEL=INFO
# PLAYGROUND_RATE_LIMIT_PER_MIN=20
# ADMIN_LOGIN_ATTEMPTS_PER_MIN=5

# ─── Which scorer decides a verdict ──────────────────────────────────────────
# vlm   a vision language model, handed the catalog as its prompt on every
#       request. The default.
# fake  canned verdicts from tagverify/scoring/fake.py. Offline development and
#       the test suite only — no key, no network, no spend. Never deploy it.
#
# "siglip" was the third value and is gone, along with its Space, its phrase
# packs and the publish step that carried one to the other. It is preserved in
# history at commit d33d463; the measurement that justified removing it is in
# inference/gate_cache.json. An unrecognised value here reports NOT CONFIGURED
# rather than falling back to a scorer nobody asked for.
# SCORER=vlm

# Read when SCORER=vlm. Set the provider and the model TOGETHER: a model id that
# does not match its provider is the kind of mistake that shows up as a bill
# rather than as an error, which is why VLM_MODEL is not defaulted per provider.
#
#   anthropic → claude-opus-5      (locally: claude-haiku-4-5)
#   gemini    → gemini-3.7-flash   (locally: gemini-2.5-flash-lite)
#
# Both providers share the prompt, the schema and every failure rule — only the
# SDK call differs — so switching is one env var and the numbers stay comparable.
#
# ⚠️ Use a PAID key, not a free tier. These are other companies' commercial
# creatives, often pre-release, submitted under the advertiser agreement. Free
# tiers commonly train on submitted content; paid tiers commonly do not. At this
# volume the paid tier is single-digit dollars a month, which removes the
# question rather than answering it.
# VLM_PROVIDER=anthropic
# VLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# GEMINI_API_KEY=xxxxxxxxxxxx
